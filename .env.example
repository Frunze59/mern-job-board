# Copy this file to server/.env (or the project root) and fill in real values.
# Never commit the real .env file.

# Port the Express server listens on. The Vite dev proxy reads this value,
# so changing it here is enough. On macOS, Control Center's AirPlay Receiver
# also listens on 5000; either turn that off or set PORT=5001 here.
PORT=5000

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-board?retryWrites=true&w=majority
MONGO_URL=

# Secret used to sign JSON Web Tokens (use a long random string)
JWT_SECRET=

# JWT expiry (task requires 1 day)
JWT_LIFETIME=1d

# Base URL used to build invitation links, e.g. http://localhost:5173 in
# development. When unset the server uses the request's own origin, which is
# correct in production because Express serves the built client.
CLIENT_URL=

# development | production (production also serves the built client from server)
NODE_ENV=development
