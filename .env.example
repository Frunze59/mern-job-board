# Copy this file to server/.env (or the project root) and fill in real values.
# Never commit the real .env file.

# Port the Express server listens on (Vite proxy expects 5000 in development)
PORT=5000

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-board?retryWrites=true&w=majority
MONGO_URL=

# Secret used to sign JSON Web Tokens (use a long random string)
JWT_SECRET=

# JWT expiry (task requires 1 day)
JWT_LIFETIME=1d

# development | production (production also serves the built client from server)
NODE_ENV=development
